{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MHudak/factorio-factory/schemas/regions.schema.json",
  "title": "Regions of one factory's map (factories/<name>/regions.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "regions"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "area", "purpose"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "area": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x1", "y1", "x2", "y2"],
            "properties": {"x1": {"type": "number"}, "y1": {"type": "number"}, "x2": {"type": "number"}, "y2": {"type": "number"}}
          },
          "purpose": {"type": "string"},
          "owner": {"type": "string", "description": "role or worker that may build here; omitted = unclaimed"},
          "hot_spot": {"type": "boolean", "default": false, "description": "shared infrastructure (main bus, rail trunk): changes need a lease"}
        }
      }
    }
  }
}
